{
  "name": "mdium-smoke",
  "version": 1,
  "env": {
    "MDIUM_EXE": "C:/Users/mtmar/source/repos/mdium/src-tauri/target/release/mdium.exe"
  },
  "description": "Phase 1 acceptance: start MDium with WebView2 debugging, create a new markdown file, type 'winuse smoke', save it via the Save As dialog to %TEMP%, verify editor text, file content and saved state, close MDium and clean up.",
  "steps": [
    {
      "tool": "delete",
      "args": {
        "path": "${TEMP}\\winuse-mdium-smoke.md"
      }
    },
    {
      "tool": "process_run",
      "args": {
        "path": "${MDIUM_EXE}",
        "webview_debug": true,
        "wait_window": "MDium",
        "require_fresh": false
      }
    },
    {
      "tool": "wait_for",
      "args": {
        "condition": "element",
        "timeout_ms": 15000,
        "selector": "role=button[name=\"新規ファイル\"]"
      }
    },
    {
      "tool": "act",
      "args": {
        "intent": "Create a new markdown file",
        "kind": "click"
      },
      "resolved": {
        "$type": "dom",
        "Window": {
          "TitleRegex": "^MDium( : .*)?$",
          "ProcessName": "mdium",
          "ClassName": "Tauri Window"
        },
        "Selector": "role=button[name=\"新規ファイル\"]"
      }
    },
    {
      "tool": "act",
      "args": {
        "intent": "Type into the markdown editor",
        "kind": "type",
        "text": "winuse smoke"
      },
      "resolved": {
        "$type": "dom",
        "Window": {
          "TitleRegex": "^MDium( : .*)?$",
          "ProcessName": "mdium",
          "ClassName": "Tauri Window"
        },
        "Selector": "body > div:nth-child(1) > div:nth-child(1) > div:nth-child(3) > div:nth-child(3) > div:nth-child(2) > div:nth-child(1) > div:nth-child(1) > div:nth-child(2) > textarea:nth-child(1)"
      }
    },
    {
      "tool": "act",
      "args": {
        "intent": "Click the Save button",
        "kind": "click"
      },
      "resolved": {
        "$type": "dom",
        "Window": {
          "TitleRegex": "^MDium( : .*)?$",
          "ProcessName": "mdium",
          "ClassName": "Tauri Window"
        },
        "Selector": "body > div:nth-child(1) > div:nth-child(1) > header:nth-child(1) > div:nth-child(3) > button:nth-child(4)"
      }
    },
    {
      "tool": "wait_for",
      "args": {
        "condition": "window",
        "timeout_ms": 10000,
        "title": "名前を付けて保存"
      }
    },
    {
      "tool": "act",
      "args": {
        "intent": "Type the file name",
        "window": "名前を付けて保存",
        "kind": "type",
        "text": "${TEMP}\\winuse-mdium-smoke.md"
      },
      "resolved": {
        "$type": "uia",
        "Window": {
          "TitleRegex": "^名前を付けて保存$",
          "ProcessName": "mdium",
          "ClassName": "#32770"
        },
        "Path": [
          {
            "ControlType": "Pane",
            "Index": 0
          },
          {
            "ControlType": "ComboBox",
            "AutomationId": "FileNameControlHost",
            "Name": "ファイル名:",
            "Index": 0
          },
          {
            "ControlType": "Edit",
            "AutomationId": "1001",
            "Name": "ファイル名:",
            "Index": 0
          }
        ]
      }
    },
    {
      "tool": "act",
      "args": {
        "intent": "Click the Save button",
        "window": "名前を付けて保存",
        "kind": "click"
      },
      "resolved": {
        "$type": "uia",
        "Window": {
          "TitleRegex": "^名前を付けて保存$",
          "ProcessName": "mdium",
          "ClassName": "#32770"
        },
        "Path": [
          {
            "ControlType": "Button",
            "AutomationId": "1",
            "Name": "保存(S)",
            "Index": 0
          }
        ]
      }
    },
    {
      "tool": "wait_for",
      "args": {
        "condition": "window_closed",
        "timeout_ms": 10000,
        "title": "名前を付けて保存"
      }
    },
    {
      "tool": "assert_text",
      "args": {
        "ref": "w225",
        "expected": "winuse smoke",
        "mode": "equals",
        "resolved_refs": {
          "ref": {
            "$type": "dom",
            "Window": {
              "TitleRegex": "^MDium( : .*)?$",
              "ProcessName": "mdium",
              "ClassName": "Tauri Window"
            },
            "Selector": "body > div:nth-child(1) > div:nth-child(1) > div:nth-child(3) > div:nth-child(3) > div:nth-child(2) > div:nth-child(1) > div:nth-child(1) > div:nth-child(2) > textarea:nth-child(1)"
          }
        }
      },
      "resolved": {
        "$type": "dom",
        "Window": {
          "TitleRegex": "^MDium( : .*)?$",
          "ProcessName": "mdium",
          "ClassName": "Tauri Window"
        },
        "Selector": "body > div:nth-child(1) > div:nth-child(1) > div:nth-child(3) > div:nth-child(3) > div:nth-child(2) > div:nth-child(1) > div:nth-child(1) > div:nth-child(2) > textarea:nth-child(1)"
      }
    },
    {
      "tool": "assert_file",
      "args": {
        "path": "${TEMP}\\winuse-mdium-smoke.md",
        "exists": true,
        "contains": "winuse smoke"
      }
    },
    {
      "tool": "check",
      "args": {
        "question": "Is the document saved?",
        "window": "^MDium"
      },
      "soft": true,
      "min_probability": 0.8
    },
    {
      "tool": "window_close",
      "args": {
        "title": "^MDium"
      }
    },
    {
      "tool": "wait_for",
      "args": {
        "condition": "window_closed",
        "timeout_ms": 10000,
        "title": "^MDium"
      }
    },
    {
      "tool": "delete",
      "args": {
        "path": "${TEMP}\\winuse-mdium-smoke.md"
      }
    }
  ]
}
